# Copy to .env and fill in. `.env` is git-ignored.

# --- Phase 1 (required) ---
DATABASE_URL=postgres://keeptrack:keeptrack@localhost:5434/keeptrack
AUTH_SECRET=            # `npx auth secret` or `openssl rand -base64 33`
AUTH_URL=http://localhost:3000

# Google sign-in (optional in dev; set both or neither). Scopes are openid/email/profile only.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Magic links. Without RESEND_API_KEY (dev only) the link is printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="KeepTrack <no-reply@keeptrack.app>"

INBOUND_DOMAIN=in.keeptrack.app

# --- Phase 3: inbound email (required in production) ---
# Resend (default): your account's receiving domain, e.g. abc123.resend.app
# (Resend dashboard → Receiving address). Put it in INBOUND_DOMAIN above.
# Webhook: event `email.received` → https://<public-url>/api/inbound/email
RESEND_WEBHOOK_SECRET=  # the webhook's signing secret (whsec_…)
# RESEND_API_KEY above must be a full-access key to read received emails.
# Postmark (alternative): Basic-auth credentials set on the inbound webhook URL.
INBOUND_WEBHOOK_USER=
INBOUND_WEBHOOK_PASSWORD=
DATA_ENCRYPTION_KEY=    # 32 bytes base64: `openssl rand -base64 32`
CRON_SECRET=            # Vercel Cron sends it as `Authorization: Bearer …`

# LLM fallback (optional). Empty → emails no store template can read become
# a pre-filled "needs review" draft. Add a key to switch it on; no code change.
ANTHROPIC_API_KEY=
LLM_PARSE_MODEL=claude-haiku-5-5
LLM_DAILY_USER_CAP=30
LLM_DAILY_GLOBAL_CAP=2000

# --- Phase 5: Web Push (required in production) ---
# Generate: npx web-push generate-vapid-keys. Push services see VAPID_SUBJECT.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@keeptrack.app

# --- Later phases (optional for now) ---
SENTRY_DSN=
